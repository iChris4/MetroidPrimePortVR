<!-- From PrimedGun's Quest launcher (res/layout/fragment_primedgun_setup.xml, Copyright 2026
     PrimedGun Project, GPL-2.0-or-later), with the PC launcher's Stop and run status, and the
     disc copy's progress. -->
<!-- The Setup tab of the launcher, in the order MainWindow builds its setup_layout. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/PrimedGunSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/primedgun_section_setup" />

        <Button
            android:id="@+id/setup_notes"
            style="@style/PrimedGunButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_setup_notes" />

        <Button
            android:id="@+id/setup_updates"
            style="@style/PrimedGunButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/primedgun_check_updates" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/primedgun_separator" />

        <TextView
            android:id="@+id/setup_selected_game"
            style="@style/PrimedGunLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:text="Selected: Metroid Prime (USA).nkit.iso"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/PrimedGunMutedLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/primedgun_select_game_note" />

            <TextView
                android:id="@+id/setup_revision_warning"
                style="@style/PrimedGunLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/primedgun_bad"
                android:visibility="gone"
                tools:text="Wrong revision"
                tools:visibility="visible" />
        </LinearLayout>

        <Button
            android:id="@+id/setup_select_game"
            style="@style/PrimedGunButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_select_game" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/setup_copy_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/setup_play"
            style="@style/PrimedGunButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_play" />

        <Button
            android:id="@+id/setup_stop"
            style="@style/PrimedGunButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_stop"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/setup_run_status"
            style="@style/PrimedGunMutedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            tools:text="Running. Settings are locked until the game closes."
            tools:visibility="visible" />

        <Button
            android:id="@+id/setup_game_options"
            style="@style/PrimedGunButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_game_options" />

        <TextView
            style="@style/PrimedGunSectionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/primedgun_section_memory_card" />

        <Button
            android:id="@+id/setup_transfer_old_save"
            style="@style/PrimedGunButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/primedgun_transfer_old_save" />

        <TextView
            android:id="@+id/setup_transfer_pending"
            style="@style/PrimedGunMutedLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/primedgun_transfer_pending"
            android:textColor="@color/primedgun_accent_text"
            android:visibility="gone"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="12dp" />

        <ImageView
            android:layout_width="208dp"
            android:layout_height="126dp"
            android:layout_gravity="start|bottom"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/primedgun_samus_art"
            android:scaleType="fitStart"
            android:src="@drawable/primedgun_samus" />
    </LinearLayout>
</ScrollView>
